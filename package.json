{
	"name": "goblin",
	"version": "2.0.0",
	"private": true,
	"description": "A custom Clash of Clans bot for EYG Family of Clans",
	"license": "MPL-2.0",
	"author": "r-priyam <roy_priyam@outlook.com>",
	"type": "module",
	"imports": {
		"#root/*": "./dist/*.js",
		"#lib/*": "./dist/lib/*.js",
		"#lib/coc": "./dist/lib/coc/index.js",
		"#utils/*": "./dist/lib/util/*.js"
	},
	"main": "dist/goblin.js",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch --onSuccess \"yarn start\"",
		"format": "prettier --write . && eslint src --fix",
		"lint": "prettier --check . && eslint src",
		"migrate": "node scripts/dbMigration.mjs",
		"migrate:new": "ley new $0 --timestamp --esm",
		"start": "node --enable-source-maps dist/goblin.js",
		"sync-docker": "node scripts/syncDocker.mjs",
		"typecheck": "tsc -b src",
		"update": "yarn upgrade-interactive",
		"watch": "tsup --watch"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*.{mjs,js,ts}": [
			"prettier --write --loglevel=warn \"src/**/*.ts\"",
			"eslint src --fix"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"resolutions": {
		"minimist": "^1.2.8"
	},
	"dependencies": {
		"@ltd/j-toml": "^1.38.0",
		"@napi-rs/canvas": "0.1.100",
		"@sapphire/cron": "^1.2.1",
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/duration": "^1.2.0",
		"@sapphire/framework": "5.5.1",
		"@sapphire/plugin-logger": "^4.1.0",
		"@sapphire/plugin-scheduled-tasks": "^10.0.4",
		"@sapphire/plugin-subcommands": "7.0.1",
		"@sapphire/result": "^2.8.0",
		"@sapphire/stopwatch": "^1.5.4",
		"@sapphire/type": "^2.6.0",
		"@sapphire/utilities": "^3.18.2",
		"@sentry/node": "8.55.2",
		"@skyra/env-utilities": "^2.0.1",
		"bufferutil": "^4.1.0",
		"bullmq": "^5.81.5",
		"clashofclans.js": "^3.6.3",
		"colorette": "^2.0.20",
		"discord-api-types": "^0.38.55",
		"discord.js": "^14.27.0",
		"figlet": "^1.11.4",
		"fuse.js": "^7.5.0",
		"gradient-string": "^3.0.0",
		"ioredis": "^5.11.1",
		"markdown-table": "^3.0.4",
		"nanoid": "^5.1.0",
		"postgres": "^3.4.9",
		"radash": "^12.1.1",
		"reflect-metadata": "^0.2.2",
		"string-strip-html": "^13.7.3",
		"undici": "^7.3.0",
		"utf-8-validate": "^6.0.6",
		"zlib-sync": "^0.1.10"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@sapphire/prettier-config": "^2.0.0",
		"@sapphire/ts-config": "^5.0.3",
		"@swc/core": "^1.16.2",
		"@types/figlet": "^1.7.0",
		"@types/gradient-string": "^1.1.6",
		"@types/node": "^22.20.2",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^9.39.5",
		"eslint-config-neon": "^0.5.4",
		"eslint-formatter-pretty": "^6.0.1",
		"ley": "^0.8.1",
		"lint-staged": "^15.5.2",
		"prettier": "^3.9.6",
		"tsup": "8.5.1",
		"typescript": "^5.9.3"
	},
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": ">=20.0.0,<21.0.0"
	}
}
